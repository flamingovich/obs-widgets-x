[Unit]
Description=OBS Widgets X — slot roulette
After=network.target

[Service]
Type=simple
User=obswidgets
Group=obswidgets
WorkingDirectory=/opt/obs-widgets-x/random-slot-roulette
EnvironmentFile=/opt/obs-widgets-x/deploy/obs-widgets-x.env
ExecStart=/usr/bin/node server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
